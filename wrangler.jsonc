{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sozan-tutor-os",
  "main": "src/v6.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html"]
  },
  "d1_databases": [
    {
      "binding": "DB"
    }
  ],
  "vars": {
    "APP_NAME": "Sozan Tutor OS"
  },
  "observability": {
    "enabled": true
  }
}
