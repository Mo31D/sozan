{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sozan-tutor-os",
  "main": "src/runtime-entry.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/index.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sozan-tutor-os-db",
      "database_id": "9a061a46-ac83-4ae7-869e-d2abbb9fb8d9"
    }
  ],
  "vars": {
    "APP_NAME": "Sozan Tutor OS"
  },
  "observability": {
    "enabled": true
  }
}
